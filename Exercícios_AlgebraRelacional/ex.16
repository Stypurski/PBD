--ATIVIDADES


SELECT *
FROM Produtos 
WHERE Qtde > 10;
SELECT '';


SELECT * 
FROM Funcionarios 
WHERE Salario > 1000.00;
SELECT '';


SELECT * 
FROM Funcionarios 
WHERE UPPER(Nome) = 'MARIA' 
  AND Salario > 1200.00;
SELECT '';


SELECT * 
FROM Produtos 
WHERE Pr_Unit >= 2.00;
SELECT '';


SELECT * 
FROM Produtos 
WHERE UPPER(Nome) IN ('LÁPIS', 'LAPIS', 'CANETA');
SELECT '';


SELECT * 
FROM Funcionarios 
WHERE Dpto < 33;
SELECT '';


SELECT * 
FROM Produtos 
WHERE Qtde > 20 
   OR Pr_Unit > 2.00;
SELECT '';


SELECT * 
FROM Funcionarios 
WHERE Matricula > 2000 
  AND Setor IN ('A4', 'B1');
SELECT '';


SELECT * 
FROM Funcionarios 
WHERE Dpto > 22 
  AND Matricula > 5000;
SELECT '';
